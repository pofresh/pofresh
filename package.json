{
  "name": "pofresh",
  "version": "3.0.1",
  "homepage": "https://github.com/ljhsai/pofresh",
  "repository": {
    "type": "git",
    "url": "https://github.com/ljhsai/pofresh.git"
  },
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint --ext .js",
    "lint:fix": "eslint packages/ plugin/ --ext .js --fix",
    "format": "prettier --write \"packages/**/*.js\" \"plugin/**/*.js\"",
    "audit": "pnpm audit --audit-level moderate",
    "security:check": "pnpm audit && pnpm run lint",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean"
  },
  "bugs": {
    "url": "https://github.com/ljhsai/pofresh/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/ljhsai/pofresh#license"
    }
  ],
  "keywords": [
    "pofresh",
    "framework",
    "game",
    "web",
    "realtime",
    "server"
  ],
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  }
}