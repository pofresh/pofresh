{
    "name": "pofresh",
    "version": "3.0.1",
    "homepage": "https://github.com/ljhsai/pofresh",
    "repository": {
        "type": "git",
        "url": "https://github.com/ljhsai/pofresh.git"
    },
    "scripts": {
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "lint": "npx ultracite@latest lint",
        "lint:fix": "npx ultracite@latest format --unsafe",
        "audit": "pnpm audit --audit-level moderate",
        "security:check": "pnpm audit && pnpm run lint",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "clean": "turbo run clean"
    },
    "bugs": {
        "url": "https://github.com/ljhsai/pofresh/issues"
    },
    "licenses": [
        {
            "type": "MIT",
            "url": "https://github.com/ljhsai/pofresh#license"
        }
    ],
    "keywords": [
        "pofresh",
        "framework",
        "game",
        "web",
        "realtime",
        "server"
    ],
    "packageManager": "pnpm@9.0.0",
    "devDependencies": {
        "@biomejs/biome": "2.1.4",
        "@vitest/coverage-v8": "^3.2.4",
        "globals": "^16.3.0",
        "turbo": "^2.5.5",
        "ultracite": "5.1.2",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=16.0.0",
        "pnpm": ">=8.0.0"
    }
}
