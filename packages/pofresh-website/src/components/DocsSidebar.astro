---
const navigation = [
  {
    title: "开始",
    items: [
      { title: "简介", href: "/docs/introduction" },
      { title: "快速开始", href: "/docs/getting-started" },
      { title: "安装指南", href: "/docs/installation" },
    ]
  },
  {
    title: "核心概念",
    items: [
      { title: "架构概览", href: "/docs/architecture" },
      { title: "服务器类型", href: "/docs/server-types" },
      { title: "路由系统", href: "/docs/routing" },
      { title: "会话管理", href: "/docs/sessions" },
      { title: "组件系统", href: "/docs/components" },
    ]
  },
  {
    title: "进阶指南",
    items: [
      { title: "分布式部署", href: "/docs/distributed" },
      { title: "性能优化", href: "/docs/performance" },
      { title: "监控运维", href: "/docs/monitoring" },
      { title: "安全配置", href: "/docs/security" },
    ]
  },
  {
    title: "API 参考",
    items: [
      { title: "服务器API", href: "/docs/api/server" },
      { title: "客户端API", href: "/docs/api/client" },
      { title: "配置API", href: "/docs/api/config" },
    ]
  }
];

const { currentPath } = Astro.props;
---

<aside class="fixed left-0 top-16 w-64 h-full bg-white border-r border-gray-200 overflow-y-auto">
  <div class="p-4">
    <div class="mb-6">
      <a href="/docs" class="text-lg font-semibold text-gray-900">
        文档导航
      </a>
    </div>
    
    <nav class="space-y-6">
      {
        navigation.map((section) => (
          <div key={section.title}>
            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-3">{section.title}</h3>
            
            <ul class="space-y-1">
              {
                section.items.map((item) => (
                  <li key={item.href}>
                    <a
                      href={item.href}
                      class={`block px-3 py-2 text-sm rounded-md transition-colors ${
                        currentPath === item.href
                          ? 'bg-primary-50 text-primary-700 font-medium'
                          : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
                      }`}
                    >
                      {item.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</aside>