---
const steps = [
  {
    step: "1",
    title: "安装 Pofresh",
    code: "npm install -g pofresh",
    description: "全局安装 Pofresh 命令行工具"
  },
  {
    step: "2",
    title: "创建项目",
    code: "pofresh init my-game-server",
    description: "初始化一个新的游戏服务器项目"
  },
  {
    step: "3",
    title: "启动服务器",
    code: "cd my-game-server && pofresh start",
    description: "启动游戏服务器，默认运行在3150端口"
  },
  {
    step: "4",
    title: "连接客户端",
    code: `const pomelo = require('pomelo-jsclient');
const client = new pomelo();
client.init({host: '127.0.0.1', port: 3014}, () => {
  console.log('连接成功！');
});`,
    description: "使用客户端SDK连接服务器"
  }
];
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        快速上手
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        只需4个简单步骤，即可启动你的第一个Pofresh游戏服务器。
      </p>
    </div>
    
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          steps.map((item) => (
            <div class="bg-white rounded-xl shadow-sm p-6 hover:shadow-md transition-shadow">
              <div class="flex items-center mb-4"
                <div class="flex-shrink-0 w-10 h-10 bg-primary-600 text-white rounded-full flex items-center justify-center font-bold text-lg"
                  {item.step}
                </div>
                <h3 class="ml-4 text-xl font-semibold text-gray-900"
                  {item.title}
                </h3>
              </div>
              
              <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg text-sm overflow-x-auto mb-4"
                <code
                  {item.code}
                </code
              </pre>
              
              <p class="text-gray-600"
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
      
      <div class="text-center mt-12"
        <a
          href="/docs/getting-started"
          class="inline-flex items-center px-6 py-3 text-lg font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
        
          查看完整文档
          <svg class="ml-2 icon-medium" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>