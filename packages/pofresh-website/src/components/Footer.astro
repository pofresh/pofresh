---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-2">
        <h3 class="text-2xl font-bold mb-4">Pofresh</h3>
        <p class="text-gray-300 mb-4">
          高性能游戏服务器框架，专为实时游戏开发而设计。
        </p>
        <div class="flex space-x-4">
          <a 
            href="https://github.com/pofresh/pofresh" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors"
          >
            <svg class="icon-large" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-lg font-semibold mb-4">文档</h4>
        <ul class="space-y-2">
          <li><a href="/docs/getting-started" class="text-gray-300 hover:text-white transition-colors">快速开始</a></li>
          <li><a href="/docs/core-concepts" class="text-gray-300 hover:text-white transition-colors">核心概念</a></li>
          <li><a href="/docs/api-reference" class="text-gray-300 hover:text-white transition-colors">API参考</a></li>
          <li><a href="/docs/examples" class="text-gray-300 hover:text-white transition-colors">示例</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-semibold mb-4">社区</h4>
        <ul class="space-y-2">
          <li><a href="/blog" class="text-gray-300 hover:text-white transition-colors">博客</a></li>
          <li><a href="/tutorials" class="text-gray-300 hover:text-white transition-colors">教程</a></li>
          <li><a href="https://github.com/pofresh/pofresh/issues" class="text-gray-300 hover:text-white transition-colors">问题反馈</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-8 text-center">
      <p class="text-gray-400">
        © {currentYear} Pofresh. 开源项目，采用 MIT 许可证。
      </p>
    </div>
  </div>
</footer>