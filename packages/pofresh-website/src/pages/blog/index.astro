---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    title: "Pofresh 2.0 发布：性能提升10倍的秘密",
    description: "介绍Pofresh 2.0版本的重大更新，包括全新的架构优化、性能提升和新功能特性。",
    date: "2024-01-15",
    author: "Pofresh团队",
    category: "发布",
    tags: ["新版本", "性能优化", "架构升级"],
    readTime: "8分钟",
    href: "/blog/pofresh-2-0-release"
  },
  {
    title: "如何构建支持百万并发的游戏服务器",
    description: "深入探讨Pofresh在高并发场景下的优化策略，包括负载均衡、连接管理和内存优化。",
    date: "2024-01-10",
    author: "技术专家",
    category: "技术",
    tags: ["高并发", "性能优化", "架构设计"],
    readTime: "12分钟",
    href: "/blog/million-concurrent-connections"
  },
  {
    title: "游戏服务器安全防护最佳实践",
    description: "分享游戏服务器面临的安全威胁和相应的防护策略，包括DDoS防护、数据加密和访问控制。",
    date: "2024-01-05",
    author: "安全专家",
    category: "安全",
    tags: ["安全防护", "最佳实践", "DDoS防护"],
    readTime: "10分钟",
    href: "/blog/security-best-practices"
  },
  {
    title: "从0到1：使用Pofresh构建实时对战游戏",
    description: "一个完整的实战案例，展示如何使用Pofresh构建一个完整的实时对战游戏，包括客户端和服务器端。",
    date: "2023-12-28",
    author: "游戏开发者",
    category: "教程",
    tags: ["实战案例", "游戏开发", "实时对战"],
    readTime: "15分钟",
    href: "/blog/realtime-battle-game-tutorial"
  }
];

const categoryColors = {
  "发布": "bg-purple-100 text-purple-800",
  "技术": "bg-blue-100 text-blue-800",
  "安全": "bg-red-100 text-red-800",
  "教程": "bg-green-100 text-green-800"
};
---

<Layout title="博客 - Pofresh" description="Pofresh官方博客，分享游戏服务器开发技术、最佳实践和最新动态">
  <Navigation />
  
  <main class="min-h-screen pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Pofresh 博客</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          分享游戏服务器开发的最新技术、最佳实践和社区动态。
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        {posts.map((post) => (
          <article class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${categoryColors[post.category]}`}>
                  {post.category}
                </span>
                <span class="text-sm text-gray-500">{post.date}</span>
              </div>

              <h2 class="text-2xl font-bold text-gray-900 mb-3">
                <a href={post.href} class="hover:text-primary-600">
                  {post.title}
                </a>
              </h2>

              <p class="text-gray-600 mb-4">
                {post.description}
              </p>

              <div class="flex flex-wrap gap-2 mb-4">
                {post.tags.map((tag) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    #{tag}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">作者：{post.author}</span>
                <span class="text-sm text-gray-500">{post.readTime}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center">
        <div class="bg-gray-50 rounded-lg p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">订阅博客更新</h2>
          <p class="text-gray-600 mb-6">
            获取最新的Pofresh技术文章和开发动态。
          </p>
          <form class="max-w-md mx-auto">
            <div class="flex gap-2">
              <input
                type="email"
                placeholder="输入你的邮箱"
                class="flex-1 px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"
              />
              <button
                type="submit"
                class="px-6 py-2 text-white bg-primary-600 rounded-md hover:bg-primary-700"
              >
                订阅
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>