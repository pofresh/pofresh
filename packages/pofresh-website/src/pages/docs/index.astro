---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import Footer from '../../components/Footer.astro';

const docs = [
  {
    category: "开始",
    items: [
      { title: "简介", href: "/docs/introduction", description: "Pofresh框架概览" },
      { title: "快速开始", href: "/docs/getting-started", description: "5分钟上手Pofresh" },
      { title: "安装指南", href: "/docs/installation", description: "详细安装步骤" },
    ]
  },
  {
    category: "核心概念",
    items: [
      { title: "架构概览", href: "/docs/architecture", description: "Pofresh的架构设计" },
      { title: "服务器类型", href: "/docs/server-types", description: "不同类型的服务器角色" },
      { title: "路由系统", href: "/docs/routing", description: "消息路由机制" },
      { title: "会话管理", href: "/docs/sessions", description: "用户会话处理" },
    ]
  },
  {
    category: "进阶指南",
    items: [
      { title: "分布式部署", href: "/docs/distributed", description: "多服务器部署" },
      { title: "性能优化", href: "/docs/performance", description: "性能调优技巧" },
      { title: "监控运维", href: "/docs/monitoring", description: "监控和运维" },
      { title: "安全配置", href: "/docs/security", description: "安全最佳实践" },
    ]
  }
];
---

<Layout title="文档 - Pofresh" description="Pofresh游戏服务器框架完整文档">
  <Navigation />
  
  <div class="flex pt-16">
    <DocsSidebar currentPath={Astro.url.pathname} />
    
    <main class="flex-1 ml-64 min-h-screen">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-gray-900 mb-4">Pofresh 文档</h1>
          <p class="text-lg text-gray-600">
            欢迎来到Pofresh文档中心。这里包含了从基础概念到高级用法的完整指南。
          </p>
        </div>

        <div class="space-y-12">
          {
            docs.map((category) => (
              <div key={category.category}>
                <h2 class="text-2xl font-bold text-gray-900 mb-6">{category.category}</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {
                    category.items.map((item) => (
                      <a
                        href={item.href}
                        class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow"
                      >
                        <h3 class="text-lg font-semibold text-primary-600 mb-2">{item.title}</h3>
                        <p class="text-gray-600">{item.description}</p>
                      </a>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </main>
  </div>
  
  <Footer />
</Layout>