---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import Footer from '../../components/Footer.astro';

const prerequisites = [
  "Node.js 16.0 或更高版本",
  "npm 或 yarn 包管理器",
  "基本的 JavaScript/TypeScript 知识",
  "了解 WebSocket 基础概念"
];

const installationSteps = [
  {
    title: "安装 Pofresh CLI",
    code: "npm install -g pofresh",
    description: "全局安装 Pofresh 命令行工具"
  },
  {
    title: "创建新项目",
    code: "pofresh init my-game-server",
    description: "使用默认模板创建一个新的游戏服务器项目"
  },
  {
    title: "进入项目目录",
    code: "cd my-game-server",
    description: "切换到新创建的项目目录"
  },
  {
    title: "启动开发服务器",
    code: "pofresh start",
    description: "启动开发服务器，默认监听 3150 端口"
  }
];

const testCode = `// 测试客户端连接
const pomelo = require('pomelo-jsclient');

const client = new pomelo();
client.init({
  host: '127.0.0.1',
  port: 3014
}, function() {
  console.log('✅ 成功连接到服务器');
  
  // 发送测试消息
  client.request('connector.entryHandler.entry', {
    username: 'test_user',
    rid: 'room_1'
  }, function(data) {
    console.log('服务器响应:', data);
  });
});`;
---

<Layout title="快速开始 - Pofresh 文档" description="5分钟快速上手Pofresh游戏服务器框架">
  <Navigation />
  
  <div class="flex pt-16">
    <DocsSidebar currentPath={Astro.url.pathname} />
    
    <main class="flex-1 ml-64 min-h-screen">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-gray-900 mb-4">快速开始</h1>
          <p class="text-lg text-gray-600">
            通过本指南，你将在5分钟内启动并运行你的第一个Pofresh游戏服务器。
          </p>
        </div>

        <div class="prose prose-lg max-w-none">
          
          <h2>环境要求</h2>
          <ul>
            {prerequisites.map(item => <li>{item}</li>)}
          </ul>

          <h2>安装步骤</h2>
          
          {installationSteps.map((step, index) => (
            <div key={index} class="mb-6">
              <h3>{step.title}</h3>
              <pre><code>{step.code}</code></pre>
              <p>{step.description}</p>
            </div>
          ))}

          <h2>验证安装</h2>
          <p>服务器启动后，你可以通过以下方式验证安装是否成功：</p>
          
          <h3>1. 查看服务器状态</h3>
          <p>打开浏览器访问：<code>http://localhost:3150/status</code></p>
          <p>你应该能看到服务器的运行状态信息。</p>

          <h3>2. 测试客户端连接</h3>
          <p>创建一个简单的Node.js脚本来测试连接：</p>
          <pre><code>{testCode}</code></pre>

          <h2>下一步</h2>
          <p>恭喜！你已经成功启动了第一个Pofresh游戏服务器。</p>
          
          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 my-6">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-blue-700">
                  <strong>建议：</strong>继续阅读<a href="/docs/architecture" class="text-blue-600 hover:text-blue-500">架构概览</a>，了解Pofresh的工作原理。
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </main>
  </div>
  
  <Footer />
</Layout>