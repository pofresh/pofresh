---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const tutorials = [
  {
    title: "创建第一个聊天服务器",
    description: "从零开始创建一个支持实时聊天的游戏服务器，学习基本的Pofresh概念",
    level: "初级",
    estimatedTime: "30分钟",
    technologies: ["Node.js", "WebSocket", "Pofresh"],
    tags: ["入门", "聊天", "实时"],
    href: "/tutorials/chat-server"
  },
  {
    title: "构建多人游戏房间系统",
    description: "学习如何创建房间系统，支持玩家匹配、房间创建和游戏状态同步",
    level: "中级",
    estimatedTime: "45分钟",
    technologies: ["Node.js", "Pofresh", "Redis"],
    tags: ["房间", "匹配", "状态同步"],
    href: "/tutorials/game-rooms"
  },
  {
    title: "实现排行榜系统",
    description: "创建一个高性能的排行榜系统，支持实时更新和历史数据存储",
    level: "中级",
    estimatedTime: "60分钟",
    technologies: ["Node.js", "Pofresh", "MongoDB"],
    tags: ["排行榜", "数据库", "性能"],
    href: "/tutorials/leaderboard"
  },
  {
    title: "分布式集群部署",
    description: "将单服务器应用扩展到多服务器集群，实现高可用和负载均衡",
    level: "高级",
    estimatedTime: "90分钟",
    technologies: ["Docker", "Kubernetes", "负载均衡"],
    tags: ["分布式", "高可用", "部署"],
    href: "/tutorials/distributed-deployment"
  },
  {
    title: "实时对战游戏开发",
    description: "开发一个完整的实时对战游戏，包括游戏逻辑、碰撞检测和状态同步",
    level: "高级",
    estimatedTime: "120分钟",
    technologies: ["游戏开发", "物理引擎", "状态同步"],
    tags: ["游戏开发", "实时对战", "物理引擎"],
    href: "/tutorials/realtime-game"
  }
];

const levelColors = {
  "初级": "bg-green-100 text-green-800",
  "中级": "bg-yellow-100 text-yellow-800",
  "高级": "bg-red-100 text-red-800"
};
---

<Layout title="教程 - Pofresh" description="通过实战教程学习Pofresh游戏服务器开发">
  <Navigation />
  
  <main class="min-h-screen pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">实战教程</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          通过实战项目学习Pofresh，从简单的聊天应用到复杂的实时对战游戏，循序渐进掌握游戏服务器开发。
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {tutorials.map((tutorial) => (
          <article key={tutorial.href} class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${levelColors[tutorial.level]}`}>
                  {tutorial.level}
                </span>
                <span class="text-sm text-gray-500">{tutorial.estimatedTime}</span>
              </div>

              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                <a href={tutorial.href} class="hover:text-primary-600">
                  {tutorial.title}
                </a>
              </h3>

              <p class="text-gray-600 mb-4">
                {tutorial.description}
              </p>

              <div class="mb-4">
                <div class="flex flex-wrap gap-2">
                  {tutorial.technologies.map((tech) => (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mb-4">
                {tutorial.tags.map((tag) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    #{tag}
                  </span>
                ))}
              </div>

              <a
                href={tutorial.href}
                class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium"
              
                开始学习
                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <div class="bg-primary-50 rounded-lg p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">需要帮助？</h2>
          <p class="text-gray-600 mb-6">
            不确定从哪里开始？我们的文档和社区随时为你提供帮助。
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center"
            <a
              href="/docs/getting-started"
              class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-primary-600 rounded-md hover:bg-primary-700"
            
              查看文档
            </a>
            
            <a
              href="https://github.com/pofresh/pofresh/discussions"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-6 py-3 text-base font-medium text-primary-700 bg-white border border-primary-600 rounded-md hover:bg-primary-50"
            
              加入讨论
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>